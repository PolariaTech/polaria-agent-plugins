{
  "description": "Trabajo en paralelo: al abrir sesión informa el CLAIM.md propio y los reclamos vigentes e instala el pre-commit de git, rechaza editar fuera de las zonas del CLAIM.md, avisa al editar una zona que reclamó otra rama, rechaza los rodeos por terminal (--no-verify, escribir el CLAIM.md) y revisa solapes con las ramas de los demás antes de un git push.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/al-iniciar-sesion.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/limitar-escritura.js\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/avisar-zona-ajena.js\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guardar-bash.js\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/revisar-antes-de-push.js\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
