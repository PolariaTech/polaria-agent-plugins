{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/al-iniciar-sesion.js\""
      }
    ],
    "preToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/limitar-escritura.js\"",
        "matcher": "Write|Delete",
        "failClosed": false
      },
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/avisar-zona-ajena.js\"",
        "matcher": "Write",
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/avisar-zona-ajena.js\"",
        "matcher": "Write",
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/guardar-bash.js\"",
        "failClosed": false
      },
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/revisar-antes-de-push.js\"",
        "matcher": "git",
        "failClosed": false
      }
    ]
  }
}
