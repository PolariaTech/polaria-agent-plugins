{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/instalar-pre-push.js\""
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/verificar-gate.js\"",
        "matcher": "git",
        "failClosed": true
      }
    ]
  }
}
